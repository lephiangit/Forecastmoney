# ─── ForecastAI .gitignore ─────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════════════
#  BÍ MẬT — không bao giờ commit
# ══════════════════════════════════════════════════════════════════════════════
# Dùng mẫu rộng để một file .env đặt sai chỗ vẫn bị chặn.
.env
.env.*
!.env.example
**/.env
**/.env.local
**/.env.*.local
*.pem
*.key
secrets.json
.streamlit/secrets.toml

# File chứa thông tin đăng nhập / API key ở dạng thô
account.txt
apikey.txt
credentials.txt
*_secret*
*_credentials*

# ══════════════════════════════════════════════════════════════════════════════
#  Python
# ══════════════════════════════════════════════════════════════════════════════
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Môi trường ảo
venv/
.venv/
env/
ENV/

# ══════════════════════════════════════════════════════════════════════════════
#  Node / Next.js
# ══════════════════════════════════════════════════════════════════════════════
node_modules/
.next/
out/
.vercel/
.netlify/
*.tsbuildinfo
next-env.d.ts

# ══════════════════════════════════════════════════════════════════════════════
#  Mô hình & dữ liệu
# ══════════════════════════════════════════════════════════════════════════════
# GHI CHÚ: global_tft.keras và tft_meta.pkl ĐƯỢC theo dõi bởi git (không ignore),
# vì Render cần kéo mô hình đã huấn luyện trực tiếp từ repo. Chúng đủ nhỏ (~2MB).
models/*.h5
models/*.pt
models/*.pth
models/*.backup.keras
models/scaler_*.pkl
models/loss_*.png

# Dữ liệu giá được tải lúc chạy hoặc trên Kaggle — không đưa vào repo
data/
*.zip

# Kết quả đánh giá (sinh lại được bằng backend/evaluate_tft.py)
models/evaluation_results.csv
models/evaluation_results.json

# ══════════════════════════════════════════════════════════════════════════════
#  IDE & hệ điều hành
# ══════════════════════════════════════════════════════════════════════════════
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ══════════════════════════════════════════════════════════════════════════════
#  Log & file tạm
# ══════════════════════════════════════════════════════════════════════════════
*.log
scratch/
tmp/
.cache/

# ══════════════════════════════════════════════════════════════════════════════
#  Tài liệu nội bộ (không public)
# ══════════════════════════════════════════════════════════════════════════════
README_INTERNAL.md
DEPLOYMENT_CHECKLIST.md
PROJECT_ACTIVITIES.md
noibo.md
logic.md
design_rule/
