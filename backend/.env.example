# ══════════════════════════════════════════════════════════════════════════════
#  ForecastAI — mẫu biến môi trường
# ══════════════════════════════════════════════════════════════════════════════
#
# Sao chép file này thành `.env` rồi điền giá trị thật.
# KHÔNG BAO GIỜ commit file `.env` lên git (đã có trong .gitignore).
#
# Trên Render: điền các biến này ở tab Environment của service, KHÔNG đưa vào repo.
# ══════════════════════════════════════════════════════════════════════════════

# ── Môi trường ────────────────────────────────────────────────────────────────
# "development" hoặc "production".
# Ở production, app sẽ TỪ CHỐI KHỞI ĐỘNG nếu secret còn để mặc định hoặc
# ALLOWED_ORIGINS vẫn là "*". Swagger UI (/docs) cũng tự động bị tắt.
ENVIRONMENT=development

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=
# Dùng service_role key cho backend (backend cần ghi vào bảng users).
# Khoá này KHÔNG BAO GIỜ được xuất hiện ở frontend.
SUPABASE_KEY=

# ── LLM (Groq) ────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Secrets ───────────────────────────────────────────────────────────────────
# Sinh giá trị an toàn cho từng khoá:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# ADMIN_SECRET_KEY  ký token đăng nhập. Đổi giá trị này sẽ khiến MỌI người dùng
#                   bị đăng xuất (token cũ không còn hợp lệ). Mật khẩu KHÔNG bị
#                   ảnh hưởng — kể từ bản 2.0, salt mật khẩu đã tách khỏi khoá này.
#
# CRON_SECRET_KEY   xác thực các job nền gọi vào /admin/trigger-*.
#                   PHẢI khác ADMIN_SECRET_KEY: secret này được gửi qua mạng
#                   thường xuyên hơn nhiều nên khả năng lộ cũng cao hơn.
ADMIN_SECRET_KEY=
CRON_SECRET_KEY=

# ── Luân chuyển khoá: giữ tài khoản cũ đăng nhập được ─────────────────────────
# CHỈ đặt biến này khi bạn vừa đổi ADMIN_SECRET_KEY và trong database còn tài khoản
# được tạo TRƯỚC bản 2.0.
#
# Lý do: định dạng hash cũ suy ra salt từ ADMIN_SECRET_KEY. Đổi khoá mà không khai
# báo giá trị cũ ở đây thì mọi mật khẩu cũ trở thành không xác thực được — người dùng
# gõ đúng mật khẩu vẫn bị từ chối, và không có cách nào khôi phục ngoài đặt lại toàn bộ.
#
# Đặt bằng giá trị ADMIN_SECRET_KEY CŨ. Mỗi lần đăng nhập thành công, hash của tài khoản
# đó tự nâng cấp sang định dạng salt ngẫu nhiên. Khi mọi người đã đăng nhập lại ít nhất
# một lần, xoá biến này đi.
LEGACY_PASSWORD_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Danh sách origin được phép gọi API, phân tách bằng dấu phẩy.
# KHÔNG dùng "*" ở production — API bật allow_credentials nên trình duyệt sẽ chặn,
# và về mặt bảo mật thì đó là mở toang cho mọi website.
# Ví dụ: ALLOWED_ORIGINS=https://forecastai.netlify.app,https://forecastai.vn
ALLOWED_ORIGINS=http://localhost:3000

# ── Rate limiting (số request mỗi phút cho mỗi IP) ────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_AUTH=10
RATE_LIMIT_EXPENSIVE=20

# ── Giới hạn input ────────────────────────────────────────────────────────────
MAX_CHAT_MESSAGE_CHARS=2000
